<% page_title_tag t("label.add_to_playlist") %>

<%= form_with model: Playlist.new, class: "c-form" do |form| %>
  <%= hidden_field_tag :song_id, params[:song_id] %>

  <div class='c-form__field c-form__field--inline'>
    <%= form.text_field :name, class: "c-input", placeholder: t("field.name"), "aria-label": t("field.name") %>
    <%= form.submit t("button.create_and_add"), class: "c-button c-button--primary u-ml-2" %>
  </div>
<% end %>

<% if @playlists.present? %>
  <%= form_tag nil do %>
    <%= hidden_field_tag :song_id, params[:song_id] %>

    <div class='c-list'>
      <%= render partial: "playlists/selections/page", locals: { playlists: @playlists, pagy: @pagy } %>
    </div>
  <% end %>
<% else %>
  <%= empty_alert_tag %>
<% end %>
