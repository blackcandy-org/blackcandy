<li id='<%= "hx-#{dom_id(playlist)}_#{dom_id(song)}" %>' class='c-list__item u-p-0' x-data='song(<%= song.id %>)' x-bind:class="{ 'is-active': isCurrent, 'is-paused': isPaused }" data-song-id='<%= song.id %>' draggable='true'>
  <div class='o-flex o-flex--align-center u-py-2'>
    <% unless mobile? %>
      <button class='c-button c-button--icon js-playlist-sortable-item-handle u-mr-2'><%= icon_tag "drag-indicator", size: "small" %></button>
    <% end %>

    <button class='c-button c-button--link o-flex__item--grow-1'
      hx-put='<%= current_playlist_playlist_path(playlist, should_play: true, song_id: song.id) %>'
      hx-trigger='song:request'
      hx-target='#hx-playlist'
      x-on:click='play'>
      <div class='o-flex o-flex--justify-between o-flex--align-center'>
        <div class='u-mr-2'>
          <span class='u-mb-1 u-text-line-clamp-2'><%= song.name %></span>
          <%= link_to song.artist.name, artist_path(song.artist), class: "c-list__item__subtext" %>
        </div>
        <div class='u-text-monospace u-mr-2'><%= format_duration(song.duration) %></div>
      </div>
    </button>
    <details class='c-dropdown' x-data='dropdown'>
      <summary class="c-button c-button--icon"><%= icon_tag "more-vertical", size: "small", title: t("label.more") %></summary>
      <div class='c-dropdown__menu' x-on:click="close">
        <button class='c-dropdown__item'
          hx-post='<%= current_playlist_songs_path(song_id: song.id, should_play: true) %>'
          hx-trigger='song:request'
          hx-target='#hx-playlist'
          name='current_song_id'
          x-bind:value='$store.player.currentSong.id'
          x-on:click='play'>
          <%= t("button.play_now") %>
        </button>
        <button class='c-dropdown__item'
          hx-post='<%= current_playlist_songs_path(song_id: song.id) %>'
          hx-target='#hx-playlist'
          name='current_song_id'
          x-bind:value='$store.player.currentSong.id'>
          <%= t("button.play_next") %>
        </button>
        <button class='c-dropdown__item'
          hx-post='<%= current_playlist_songs_path(song_id: song.id, location: "last") %>'
          hx-target='#hx-playlist'>
          <%= t("button.play_last") %>
        </button>
        <%= button_to(
              t("button.delete"),
              playlist_song_path(playlist, song),
              method: :delete,
              form_class: "c-dropdown__item"
            ) %>
        <%= dialog_link_to t("label.add_to_playlist"), playlists_selections_path(song_id: song.id), class: "c-dropdown__item" %>
        <%= link_to(
              t("label.go_to_artist"),
              artist_path(song.artist),
              class: "c-dropdown__item"
            ) %>
      </div>
    </details>
  </div>
</li>
