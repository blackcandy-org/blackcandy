<% content_for :head do %>
  <%= render partial: "shared/theme_meta", locals: { theme: Current.user.theme } %>
<% end %>

<% content_for :body do %>
  <%= turbo_stream_from "media_sync" if is_admin? %>
  <%= turbo_stream_from Current.user, :theme %>

  <% if native_app? %>
    <%= render "shared/flash" %>
    <main class='<%= "u-p-5 u-p-3@small" unless content_for?(:fluid_layout) %>'>
      <%= content_for?(:content) ? yield(:content) : yield %>
    </main>
  <% else %>
    <div class='o-flex'>
      <aside id='js-player' class='o-flex__item o-flex__item--shrink-0 c-sidebar' data-controller='player'>
        <div class='o-flex o-flex--column-reverse u-position-sticky-top u-overflow-auto u-vh-100'>
          <div class='o-flex__item o-flex__item--shrink-0 u-p-2 u-pt-0'>
            <%= render "shared/player" %>
          </div>
          <div class='o-flex__item o-flex__item--grow-1 u-h-0'>
            <%= turbo_frame_tag "turbo-playlist", src: current_playlist_songs_path, class: "u-h-100 o-flex o-flex--column", data: { "player-target" => "playlistFrame" } %>
            <%= turbo_frame_tag "turbo-lyrics", loading: "lazy", class: "c-lyrics u-display-none", data: { "player-target" => "lyricsFrame" } do %>
              <%= loader_tag class: "c-lyrics__loader" %>
              <%= empty_alert_tag message: t("label.no_lyrics") %>
            <% end %>
          </div>
        </div>
      </aside>
      <div id='js-app' class='o-flex__item o-flex__item--grow-1 u-pb-7@extra-small'>
        <%= render "shared/flash" %>
        <div>
          <header class='c-nav c-nav--primary u-position-sticky-top'>
            <%= render partial: "shared/top_bar", locals: { current_user: Current.user, current_controller: controller_name, query: params[:query] } %>
          </header>
          <main class='<%= "o-container--wide u-p-5 u-p-3@small u-p-2@extra-narrow" unless content_for?(:fluid_layout) %>'>
            <%= content_for?(:content) ? yield(:content) : yield %>
          </main>
          <footer class='u-display-none u-display-block@extra-small u-position-fixed-bottom'>
            <%= render "shared/mini_player" %>
            <%= render "shared/bottom_nav" %>
          </footer>
        </div>
        <%= render "shared/dialog_frame" %>
      </div>
    </div>
  <% end %>
<% end %>

<%= render template: "layouts/base" %>
