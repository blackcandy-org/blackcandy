<% page_title_tag t("label.edit_song") %>

<%= form_with model: @song, data: { "turbo-frame" => "_top", "turbo-action" => ("replace" if native_app?) }, class: "c-form" do |form| %>
  <div class='c-form__field'>
    <%= form.label :lyrics_file, t("field.lyrics") %>
    <%= form.file_field :lyrics_file, accept: Song::ALLOWED_LYRICS_FILE_EXTENSION, class: "c-input" %>
    <% if @song.lyrics.present? %>
      <small><%= t("text.replace_lyrics") %></small>
    <% end %>
  </div>
  <div class='c-form__field c-form__field--submit'>
    <%= form.submit t("button.save"), class: "c-button c-button--primary c-button--full-width" %>
  </div>
<% end %>
