<% lines = @song.lyrics_lines %>

<% if lines.empty? %>
  <%= empty_alert_tag message: t("label.no_lyrics") %>
<% else %>
  <div
    class='c-lyrics__lines'
    data-controller='lyrics'
    data-lyrics-player-outlet='#js-player'
    data-action='click->lyrics#seek wheel->lyrics#suspendFollowing:passive touchmove->lyrics#suspendFollowing:passive'>
    <% lines.each do |line| %>
      <%= tag.p line.content, class: "c-lyrics__line", data: { lyrics_target: "line", time: line.time } %>
    <% end %>
  </div>
<% end %>
